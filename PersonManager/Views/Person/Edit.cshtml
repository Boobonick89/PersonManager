@model PersonManager.Models.Person;
<h1>Редактирование</h1>

<form asp-action="Edit" method="post">
	<input type="hidden" asp-for="Id"/>

	<div class="edit-field">
		<label asp-for="LastName">Фамилия</label>
		<input asp-for="LastName"/>
		<span asp-validation-for="LastName" class="text-danger"></span>

		<label asp-for="FirstName">Имя</label>
		<input asp-for="FirstName"/>
		<span asp-validation-for="FirstName" class="text-danger"></span>

		<label asp-for="MiddleName">Отчество</label>
		<input asp-for="MiddleName"/>
		<span asp-validation-for="MiddleName" class="text-danger"></span>
	</div>

	<div class="edit-field">
		<label asp-for="Age"></label>
		<input asp-for="Age"/> 
		<span asp-validation-for="Age"></span>
	</div>

	<button type="submit" class="action-button add-button">
		Сохранить
		</button>

</form>