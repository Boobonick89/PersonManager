@model PersonManager.ViewModels.PersonViewModel

<form asp-action="Create" method="post">
	

	<dialog id="addWindow">
		<h2>Добавить человека</h2>
		<div>
			<label asp-for="NewPerson.LastName">Фамилия</label>
			<input asp-for="NewPerson.LastName" />
			<span asp-validation-for="NewPerson.LastName" class="text-danger"></span>
		</div>
		
		<div>
			<label asp-for="NewPerson.FirstName">Имя</label>
			<input asp-for="NewPerson.FirstName" />
			<span asp-validation-for="NewPerson.FirstName" class="text-danger"></span>
		</div>

		<div>
			<label asp-for="NewPerson.MiddleName">Отчество</label>
			<input asp-for="NewPerson.MiddleName" />
			<span asp-validation-for="NewPerson.MiddleName" class="text-danger"></span>
		</div>

		<div>
			<label asp-for="NewPerson.Age">Возраст</label>
			<input asp-for="NewPerson.Age" />
			<span asp-validation-for="NewPerson.Age"></span>
		</div>

		<button type="submit" class="action-button add-button">
			Добавить
		</button>
		<button type="button" id="closeButton" class="action-button edit-button">
			Закрыть
		</button>

	</dialog>
</form>